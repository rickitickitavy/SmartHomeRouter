{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": ".cursor/hooks/block-master-develop-git.py",
        "matcher": "git\\s+(commit|push)",
        "failClosed": true
      },
      {
        "command": ".cursor/hooks/block-git-rollback.py",
        "matcher": "git\\s+(restore|reset|revert|clean|checkout|switch)",
        "failClosed": true
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": ".cursor/hooks/inject-no-unilateral-behavior.py"
      }
    ],
    "preToolUse": [
      {
        "command": ".cursor/hooks/fragile-zones-guard.py",
        "matcher": "Write|StrReplace|Delete|EditNotebook",
        "failClosed": true
      }
    ]
  }
}
