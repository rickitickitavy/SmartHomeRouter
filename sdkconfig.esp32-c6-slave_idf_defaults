# ESP32-C6 slave — Zigbee ZCZR + OTA + LittleFS (PlatformIO SDKCONFIG_DEFAULTS append).
CONFIG_IDF_TARGET="esp32c6"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/zigbee_zczr_16MB.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions/zigbee_zczr_16MB.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

# Zigbee coordinator (ZCZR) — matches Arduino -DZIGBEE_MODE_ZCZR link set.
CONFIG_ZB_ENABLED=y
CONFIG_ZB_RADIO_NATIVE=y
CONFIG_ZB_ZCZR=y

CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30
